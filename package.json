{
  "name": "@rmartz/pr-lifecycle-app",
  "version": "0.0.0-development",
  "private": true,
  "description": "Hosted GitHub App that runs the @rmartz/pr-lifecycle reconciler from webhooks, so adopting pr-lifecycle in a repo is install-only.",
  "homepage": "https://github.com/rmartz/pr-lifecycle-app#readme",
  "bugs": {
    "url": "https://github.com/rmartz/pr-lifecycle-app/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmartz/pr-lifecycle-app.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "hygiene": "repo-hygiene --check --config .repo-hygiene.yml",
    "hygiene:staged": "repo-hygiene --staged --config .repo-hygiene.yml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rmartz/repo-hygiene": "16.0.0",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@rmartz/merge-safety": "0.18.0",
    "@rmartz/pr-lifecycle": "12.0.0",
    "@rmartz/pr-policy": "1.8.0",
    "@vercel/functions": "3.10.6",
    "@vercel/sandbox": "3.9.1",
    "universal-github-app-jwt": "2.2.2"
  }
}
