{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The type-check config: covers src/ AND test/ so test code is held to the same
  // strict rules as the server. The build uses tsconfig.build.json, which narrows
  // this to src/ with a rootDir/outDir.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM supplies the Fetch API types (Request, Response) for Vercel's own
    // per-function type-check, which doesn't pick them up from @types/node.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "api/**/*.ts"]
}
